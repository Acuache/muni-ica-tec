NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
CRON_SECRET=
# URL pública del sitio. Se usa para armar el link de recuperación de contraseña
# que llega al correo. En local puede omitirse (cae a http://localhost:3000);
# en producción es OBLIGATORIA y sin barra final, ej: https://muni-ica-tec.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
